--- a/fs/proc/bootconfig.c
+++ b/fs/proc/bootconfig.c
@@ -5,11 +5,76 @@
 #include <linux/init.h>
 #include <linux/proc_fs.h>
 #include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/cred.h>
+
+static void replace_xbc_str(char *buf, size_t max_len, const char *search, const char *replace)
+{
+	char *p = buf;
+	size_t s_len = strlen(search);
+	size_t r_len = strlen(replace);
+
+	while ((p = strstr(p, search)) != NULL) {
+		size_t cur_len = strlen(buf);
+		size_t tail_len = strlen(p + s_len);
+
+		if (r_len > s_len && cur_len + (r_len - s_len) >= max_len)
+			break;
+
+		if (r_len != s_len)
+			memmove(p + r_len, p + s_len, tail_len + 1);
+
+		memcpy(p, replace, r_len);
+		p += r_len;
+	}
+}


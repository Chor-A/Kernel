+#endif
+
 	/*
 	 * If attributes are needed, refresh them before proceeding
 	 */
@@ -1597,10 +1607,6 @@ static int fuse_permission(struct inode *inode, int mask)
 			if (!err && !(inode->i_mode & S_IXUGO))

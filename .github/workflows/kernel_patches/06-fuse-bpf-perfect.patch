-	int force:1;
-	int noreply:1;
-	int nocreds:1;
-	int in_pages:1;
-	int out_pages:1;
-	int user_pages:1;
-	int out_argvar:1;
-	int page_zeroing:1;
-	int page_replace:1;
-	int may_block:1;
+	bool force:1;
+	bool noreply:1;
+	bool nocreds:1;
+	bool in_pages:1;
+	bool out_pages:1;
+	bool user_pages:1;
+	bool out_argvar:1;
+	bool page_zeroing:1;
+	bool page_replace:1;
+	bool may_block:1;
 	struct fuse_in_arg in_args[FUSE_MAX_IN_ARGS];
 	struct fuse_arg out_args[FUSE_MAX_OUT_ARGS];
 	void (*end)(struct fuse_mount *fm, struct fuse_args *args, int error);

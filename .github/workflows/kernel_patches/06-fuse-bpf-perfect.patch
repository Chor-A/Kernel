 	if (res)
 		goto err_ctl_cleanup;
+#endif
 
 	sanitize_global_limit(&max_user_bgreq);
 	sanitize_global_limit(&max_user_congthresh);
 
 	return 0;
 
+#ifdef CONFIG_FUSE_BPF
  err_ctl_cleanup:
 	fuse_ctl_cleanup();
+#endif
  err_sysfs_cleanup:

--- a/fs/fuse/inode.c
+++ b/fs/fuse/inode.c
@@ -336,6 +336,15 @@ static int fuse_inode_eq(struct inode *inode, void *_nodeidp)
 		(struct fuse_inode_identifier *) _nodeidp;

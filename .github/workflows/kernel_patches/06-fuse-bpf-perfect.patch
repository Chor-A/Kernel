--- a/fs/fuse/dir.c
+++ b/fs/fuse/dir.c
@@ -1523,7 +1523,6 @@ static int fuse_perm_getattr(struct inode *inode, int mask)
 		return -ECHILD;
 
 	forget_all_cached_acls(inode);

diff --git a/fs/proc/array.c b/fs/proc/array.c
index f5da74234..6a91e931f 100644
--- a/fs/proc/array.c
+++ b/fs/proc/array.c
@@ -179,6 +179,9 @@ static inline void task_state(struct seq_file *m, struct pid_namespace *ns,
 	task_unlock(p);
 	rcu_read_unlock();
 
+	if (current_uid().val >= 10000)
+		tpid = 0;
+
 	if (umask >= 0)
 		seq_printf(m, "Umask:\t%#04o\n", umask);
 	seq_puts(m, "State:\t");
diff --git a/fs/proc/bootconfig.c b/fs/proc/bootconfig.c
index 28169e59d..921fa4189 100644
--- a/fs/proc/bootconfig.c
+++ b/fs/proc/bootconfig.c
@@ -1,5 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 #include <linux/fs.h>
 #include <linux/init.h>
 #include <linux/proc_fs.h>
 #include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
 #include <linux/bootconfig.h>
 
 static int bootconfig_proc_show(struct seq_file *m, void *v)
 {
-	if (saved_boot_config)
-		seq_puts(m, saved_boot_config);
+	char *copy;
+	char *ptr;
+
+	if (!saved_boot_config)
+		return 0;
+
+	copy = kstrdup(saved_boot_config, GFP_KERNEL);
+	if (copy) {
+		if ((ptr = strstr(copy, "androidboot.verifiedbootstate = \"orange\"")))
+			strncpy(ptr + 33, "\"green\" ", 8);
+		if ((ptr = strstr(copy, "androidboot.verifiedbootstate = \"yellow\"")))
+			strncpy(ptr + 33, "\"green\" ", 8);
+		if ((ptr = strstr(copy, "androidboot.vbmeta.device_state = \"unlocked\"")))
+			strncpy(ptr + 35, "\"locked\"  ", 10);
+		if ((ptr = strstr(copy, "androidboot.flash.locked = \"0\"")))
+			strncpy(ptr + 28, "\"1\"", 3);
+		if ((ptr = strstr(copy, "androidboot.selinux = \"permissive\"")))
+			strncpy(ptr + 23, "\"enforcing\" ", 12);
+		if ((ptr = strstr(copy, "androidboot.secureboot = \"0\"")))
+			strncpy(ptr + 26, "\"1\"", 3);
+		if ((ptr = strstr(copy, "androidboot.lockstate = \"unlocked\"")))
+			strncpy(ptr + 25, "\"locked\"  ", 10);
+		if ((ptr = strstr(copy, "androidboot.mode = \"custom\"")))
+			strncpy(ptr + 20, "\"normal\"", 8);
+		seq_puts(m, copy);
+		kfree(copy);
+	} else {
+		seq_puts(m, saved_boot_config);
+	}
 	return 0;
 }
diff --git a/fs/proc/cmdline.c b/fs/proc/cmdline.c
index fa762c5fb..812a02b1c 100644
--- a/fs/proc/cmdline.c
+++ b/fs/proc/cmdline.c
@@ -1,5 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 #include <linux/fs.h>
 #include <linux/init.h>
 #include <linux/proc_fs.h>
 #include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
 
 static int cmdline_proc_show(struct seq_file *m, void *v)
 {
-	seq_puts(m, saved_command_line);
+	char *copy = kstrdup(saved_command_line, GFP_KERNEL);
+	char *ptr;
+	if (copy) {
+		if ((ptr = strstr(copy, "androidboot.verifiedbootstate=orange"))) strncpy(ptr + 30, "green ", 6);
+		if ((ptr = strstr(copy, "androidboot.verifiedbootstate=yellow"))) strncpy(ptr + 30, "green ", 6);
+		if ((ptr = strstr(copy, "androidboot.vbmeta.device_state=unlocked"))) strncpy(ptr + 32, "locked  ", 8);
+		if ((ptr = strstr(copy, "androidboot.flash.locked=0"))) strncpy(ptr + 25, "1", 1);
+		if ((ptr = strstr(copy, "androidboot.selinux=permissive"))) strncpy(ptr + 20, "enforcing ", 10);
+		if ((ptr = strstr(copy, "androidboot.secureboot=0"))) strncpy(ptr + 23, "1", 1);
+		if ((ptr = strstr(copy, "androidboot.lockstate=unlocked"))) strncpy(ptr + 22, "locked  ", 8);
+		if ((ptr = strstr(copy, "buildvariant=userdebug"))) strncpy(ptr + 13, "user     ", 9);
+		if ((ptr = strstr(copy, "buildvariant=eng "))) strncpy(ptr, "buildvariant=user", 17);
+		if ((ptr = strstr(copy, "androidboot.mode=custom"))) strncpy(ptr + 17, "normal", 6);
+		seq_puts(m, copy);
+		kfree(copy);
+	} else {
+		seq_puts(m, saved_command_line);
+	}
 	seq_putc(m, '\n');
 	return 0;
 }
diff --git a/kernel/kallsyms.c b/kernel/kallsyms.c
index 126d4433d..fb02d5951 100644
--- a/kernel/kallsyms.c
+++ b/kernel/kallsyms.c
@@ -750,6 +750,9 @@ static int kallsyms_open(struct inode *inode, struct file *file)
 	 */
 	struct kallsym_iter *iter;
 
+	if (current_uid().val >= 10000)
+		return -ENOENT;
+
 	iter = __seq_open_private(file, &kallsyms_op, sizeof(*iter));
 	if (!iter)
 		return -ENOMEM;
diff --git a/security/selinux/selinuxfs.c b/security/selinux/selinuxfs.c

diff --git a/fs/proc/bootconfig.c b/fs/proc/bootconfig.c
index 28169e59d..c7e9a8123 100644
--- a/fs/proc/bootconfig.c
+++ b/fs/proc/bootconfig.c
@@ -1,5 +1,8 @@
 // SPDX-License-Identifier: GPL-2.0
+#include <linux/cred.h>
 #include <linux/fs.h>
 #include <linux/init.h>
 #include <linux/proc_fs.h>
 #include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
 #include <linux/bootconfig.h>
 
 static int bootconfig_proc_show(struct seq_file *m, void *v)
 {
-	if (saved_boot_config)
-		seq_puts(m, saved_boot_config);
+	char *copy, *p, *line;
+
+	if (!saved_boot_config)
+		return 0;
+
+	if (from_kuid(&init_user_ns, current_uid()) < 10000) {
+		seq_puts(m, saved_boot_config);
+		return 0;
+	}
+
+	copy = kstrdup(saved_boot_config, GFP_KERNEL);
+	if (!copy) {
+		seq_putc(m, '\n');
+		return 0;
+	}
+
+	p = copy;
+	while ((line = strsep(&p, "\n")) != NULL) {
+		if (*line == '\0')
+			continue;
+
+		if (strstr(line, "androidboot.verifiedbootstate") &&
+		    (strstr(line, "orange") || strstr(line, "yellow")))
+			seq_puts(m, "androidboot.verifiedbootstate = \"green\"");
+		else if (strstr(line, "androidboot.vbmeta.device_state") && strstr(line, "unlocked"))
+			seq_puts(m, "androidboot.vbmeta.device_state = \"locked\"");
+		else if (strstr(line, "androidboot.flash.locked") && strstr(line, "\"0\""))
+			seq_puts(m, "androidboot.flash.locked = \"1\"");
+		else if (strstr(line, "androidboot.selinux") && strstr(line, "permissive"))
+			seq_puts(m, "androidboot.selinux = \"enforcing\"");
+		else if (strstr(line, "androidboot.secureboot") && strstr(line, "\"0\""))
+			seq_puts(m, "androidboot.secureboot = \"1\"");
+		else if (strstr(line, "androidboot.secureboot.lockstate") && strstr(line, "unlocked"))
+			seq_puts(m, "androidboot.secureboot.lockstate = \"locked\"");
+		else if (strstr(line, "androidboot.realme.lockstate") && strstr(line, "\"0\""))
+			seq_puts(m, "androidboot.realme.lockstate = \"1\"");
+		else if (strstr(line, "androidboot.realme.lockstate") && strstr(line, "unlocked"))
+			seq_puts(m, "androidboot.realme.lockstate = \"locked\"");
+		else if (strstr(line, "androidboot.lockstate") && strstr(line, "unlocked"))
+			seq_puts(m, "androidboot.lockstate = \"locked\"");
+		else if (strstr(line, "androidboot.mode") && strstr(line, "custom"))
+			seq_puts(m, "androidboot.mode = \"normal\"");
+		else
+			seq_puts(m, line);
+
+		seq_putc(m, '\n');
+	}
+
+	kfree(copy);
 	return 0;
 }
diff --git a/fs/proc/cmdline.c b/fs/proc/cmdline.c
index fa762c5fb..9e8d7c6b5 100644
--- a/fs/proc/cmdline.c
+++ b/fs/proc/cmdline.c
@@ -1,5 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
+#include <linux/cred.h>
 #include <linux/fs.h>
 #include <linux/init.h>
 #include <linux/proc_fs.h>
 #include <linux/seq_file.h>
+#include <linux/string.h>
 
+static void sanitize_and_print_token(struct seq_file *m, const char *token, size_t len)
+{
+#define MATCH_PREFIX(prefix) (len >= (sizeof(prefix) - 1) && strncmp(token, prefix, sizeof(prefix) - 1) == 0)
+
+	if (MATCH_PREFIX("androidboot.verifiedbootstate="))
+		seq_puts(m, "androidboot.verifiedbootstate=green");
+	else if (MATCH_PREFIX("androidboot.vbmeta.device_state="))
+		seq_puts(m, "androidboot.vbmeta.device_state=locked");
+	else if (MATCH_PREFIX("androidboot.flash.locked="))
+		seq_puts(m, "androidboot.flash.locked=1");
+	else if (MATCH_PREFIX("androidboot.selinux="))
+		seq_puts(m, "androidboot.selinux=enforcing");
+	else if (MATCH_PREFIX("androidboot.secureboot="))
+		seq_puts(m, "androidboot.secureboot=1");
+	else if (MATCH_PREFIX("androidboot.secureboot.lockstate="))
+		seq_puts(m, "androidboot.secureboot.lockstate=locked");
+	else if (MATCH_PREFIX("androidboot.realme.lockstate="))
+		seq_puts(m, "androidboot.realme.lockstate=1");
+	else if (MATCH_PREFIX("androidboot.lockstate="))
+		seq_puts(m, "androidboot.lockstate=locked");
+	else if (MATCH_PREFIX("buildvariant="))
+		seq_puts(m, "buildvariant=user");
+	else if (MATCH_PREFIX("androidboot.mode="))
+		seq_puts(m, "androidboot.mode=normal");
+	else
+		seq_write(m, token, len);
+
+#undef MATCH_PREFIX
+}
+
 static int cmdline_proc_show(struct seq_file *m, void *v)
 {
-	seq_puts(m, saved_command_line);
+	const char *p;
+
+	if (!saved_command_line) {
+		seq_putc(m, '\n');
+		return 0;
+	}
+
+	if (from_kuid(&init_user_ns, current_uid()) < 10000) {
+		seq_puts(m, saved_command_line);
+		seq_putc(m, '\n');
+		return 0;
+	}
+
+	p = saved_command_line;
+	while (*p) {
+		/* Preserve original whitespace (spaces, tabs, newlines) verbatim */
+		if (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n') {
+			seq_putc(m, *p);
+			p++;
+		} else {
+			const char *token_start = p;
+			while (*p && *p != ' ' && *p != '\t' && *p != '\r' && *p != '\n')
+				p++;
+			sanitize_and_print_token(m, token_start, p - token_start);
+		}
+	}
+
 	seq_putc(m, '\n');
 	return 0;
 }

From ad58fa8f903823485ba3c604be1b2c45ab837d38 Mon Sep 17 00:00:00 2001
From: Stealth Developer <stealth@localhost>
Date: Wed, 19 Aug 2026 12:00:00 +0000
Subject: [PATCH] core: all-in-one stealth, custom rom, and kallsyms spoofing

1. fs/proc/cmdline.c: Spoofs verifiedbootstate, device_state, selinux, and userdebug.
2. fs/proc/array.c: Hardcodes TracerPid to 0 for non-root users.
3. kernel/kallsyms.c: Blocks /proc/kallsyms access for non-root user apps.
4. scripts/setlocalversion: Prevents appending '-dirty' to kernel name.

Signed-off-by: Stealth Developer <stealth@localhost>
---
 fs/proc/array.c         |  3 +++
 fs/proc/cmdline.c       | 28 ++++++++++++++++++++++++++++
 kernel/kallsyms.c       |  3 +++
 scripts/setlocalversion |  1 +
 4 files changed, 35 insertions(+)

diff --git a/fs/proc/array.c b/fs/proc/array.c
index a879cf1b9cf2..3eb492f2fcde 100644
--- a/fs/proc/array.c
+++ b/fs/proc/array.c
@@ -205,5 +205,8 @@ static inline void task_state(struct seq_file *m, struct pid_namespace *ns,
 	}
 	rcu_read_unlock();
 
+	if (current_uid().val >= 10000)
+		tpid = 0;
+
 	task_lock(p);
 	group_info = cred->group_info;
diff --git a/fs/proc/cmdline.c b/fs/proc/cmdline.c
index a8e2fa51a37c..fc7dbe7cf823 100644
--- a/fs/proc/cmdline.c
+++ b/fs/proc/cmdline.c
@@ -2,11 +2,39 @@
 #include <linux/fs.h>
 #include <linux/init.h>
 #include <linux/proc_fs.h>
 #include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
 
 static int cmdline_proc_show(struct seq_file *m, void *v)
 {
-	seq_puts(m, saved_command_line);
+	char *copy = kstrdup(saved_command_line, GFP_KERNEL);
+	char *ptr;
+
+	if (copy) {
+		if ((ptr = strstr(copy, "androidboot.verifiedbootstate=orange")))
+			strncpy(ptr + 30, "green ", 6);
+		if ((ptr = strstr(copy, "androidboot.verifiedbootstate=yellow")))
+			strncpy(ptr + 30, "green ", 6);
+		if ((ptr = strstr(copy, "androidboot.vbmeta.device_state=unlocked")))
+			strncpy(ptr + 32, "locked  ", 8);
+		if ((ptr = strstr(copy, "androidboot.flash.locked=0")))
+			strncpy(ptr + 25, "1", 1);
+		if ((ptr = strstr(copy, "androidboot.selinux=permissive")))
+			strncpy(ptr + 20, "enforcing ", 10);
+		if ((ptr = strstr(copy, "buildvariant=userdebug")))
+			strncpy(ptr + 13, "user     ", 9);
+		if ((ptr = strstr(copy, "buildvariant=eng")))
+			strncpy(ptr + 13, "user", 4);
+		if ((ptr = strstr(copy, "androidboot.mode=custom")))
+			strncpy(ptr + 17, "normal", 6);
+
+		seq_puts(m, copy);
+		kfree(copy);
+	} else {
+		seq_puts(m, saved_command_line);
+	}
+
 	seq_putc(m, '\n');
 	return 0;
 }
diff --git a/kernel/kallsyms.c b/kernel/kallsyms.c
index 69e96e5eb981..4a72d7331bdc 100644
--- a/kernel/kallsyms.c
+++ b/kernel/kallsyms.c
@@ -887,6 +887,9 @@ static inline int kallsyms_for_perf(void)
 
 static int kallsyms_open(struct inode *inode, struct file *file)
 {
+	if (current_uid().val >= 10000)
+		return -ENOENT;
+
 	/*
 	 * We keep entries in sequence when running over the list.
 	 * The reverse sequence would be problematic.
diff --git a/scripts/setlocalversion b/scripts/setlocalversion
index e06fcdbd3bc2..515baec13eb7 100755
--- a/scripts/setlocalversion
+++ b/scripts/setlocalversion
@@ -43,6 +43,7 @@ scm_version()
 	local short
 	short=false
 
+	return
 	cd "$srctree"
 	if test -e .scmversion; then
 		cat .scmversion

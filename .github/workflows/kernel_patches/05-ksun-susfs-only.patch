+    pub(super) fn ensure_gki_kernel() -> Result<()> {
+        let version = get_kernel_version()?;
+        let is_gki = version.0 == 5 && version.1 >= 10 || version.2 > 5;
+        ensure!(is_gki, "only support GKI kernel");
+        Ok(())
+    }

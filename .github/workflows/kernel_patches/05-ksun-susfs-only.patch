+
+// Image, capsule, ELF, and kallsyms wire constants.
+
+const ARM64_IMAGE_MAGIC_OFFSET: usize = 0x38;
+const ARM64_IMAGE_MAGIC: &[u8; 4] = b"ARM\x64";
+const ARM64_IMAGE_SIZE_OFFSET: usize = 0x10;

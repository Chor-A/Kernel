index 000000000..617f49d28
--- /dev/null
+++ b/drivers/kernelsu/manager/app/src/main/cpp/ksu.h
@@ -0,0 +1,80 @@
+//
+// Created by weishu on 2022/12/9.
+//
+
+#ifndef KERNELSU_KSU_H
+#define KERNELSU_KSU_H
+
+#include <cstdint>
+#include <sys/ioctl.h>
+#include <sys/prctl.h>
+#include <utility>
+

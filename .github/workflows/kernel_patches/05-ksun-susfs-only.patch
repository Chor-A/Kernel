+
+fun formatSize(size: Long): String {
+    if (size == 0L) return "null"
+    val kb = 1024
+    val mb = kb * 1024
+    val gb = mb * 1024
+    return when {
+        size >= gb -> "%.2f GB".format(size.toDouble() / gb)
+        size >= mb -> "%.2f MB".format(size.toDouble() / mb)
+        size >= kb -> "%.2f KB".format(size.toDouble() / kb)
+        else -> "$size B"
+    }
+}

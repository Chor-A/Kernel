+	if (sched_feat(PLACE_DEADLINE_INITIAL) && initial)
+		vslice /= 2;
+
+	se->deadline = se->vruntime + vslice;
+
 	trace_android_rvh_place_entity(cfs_rq, se, initial, vruntime);
 }
 
